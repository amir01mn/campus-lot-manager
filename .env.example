# Copy to .env and adjust. docker compose reads .env automatically; .env is gitignored.
# Every value has a demo-safe default in docker-compose.yml, so .env is optional for local demos.

# Spring profile: `demo` seeds demo accounts, ~2 months of bookings and simulated sensors.
# Use `prod` for a real deployment: it refuses to start unless the three secrets below are changed.
SPRING_PROFILES_ACTIVE=demo

# Database (shared by the postgres and backend services)
DB_NAME=parking
DB_USER=parking
DB_PASSWORD=parking
# Host port for Postgres, bound to 127.0.0.1 only
POSTGRES_PORT=5432

# Secrets: change all three for anything that isn't a local demo.
# HS256 signing key, at least 32 bytes, e.g. `openssl rand -base64 48`
APP_JWT_SECRET=dev-only-change-me-dev-only-change-me-0123456789
APP_JWT_EXPIRY=PT1H
# Shared key sensors send in the X-Sensor-Key header
APP_SENSORS_API_KEY=dev-sensor-key
# Super manager created on first start (an existing account is never modified)
APP_SUPER_MANAGER_EMAIL=admin@campus-parking.local
APP_SUPER_MANAGER_PASSWORD=ChangeMe!2024

# Password of the seeded demo accounts (demo profile only)
APP_DEMO_PASSWORD=Demo#2026

# Origins allowed to call the API cross-origin. The bundled nginx proxies same-origin, so this only matters for
# other clients (e.g. the Vite dev server on :5173 talking to the API directly).
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Web UI
WEB_PORT=3000
# Build-time: set to false to hide the one-click demo sign-in buttons
VITE_SHOW_DEMO_ACCOUNTS=true

# JVM flags for the backend container
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:InitialRAMPercentage=25 -XX:+ExitOnOutOfMemoryError
